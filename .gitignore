# macOS
.DS_Store

# Release archives are build output, except the published ones under spec/.
# The pattern is deliberately per-directory rather than per-version: a new
# release must not be silently excluded because nobody added a negation.
*.zip
!spec/*/OBDS-*-FINAL.zip

# Generated by running the conformance suite or by a local virtualenv. The
# release gate treats these as caches rather than package junk, and they must
# never be committed.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.eggs/
.venv/
.venv*/
node_modules/

# Local-only material, kept outside this repository. The archive/ guard stays so
# that release archives or scraped external references cannot be re-introduced
# here by accident.
archive/
openbranddefinition-site-*-public-draft/

# Local working notes, not site content
answers/

# Withdrawn custom-licensing drafts, replaced by CC BY 4.0 + Apache 2.0 in 1.0.2
md/
licensing/

# Hosting. The site is deployed to Vercel; neither the project link nor any
# downloaded environment file belongs in a public repository.
.vercel
.env*.local

{
  "$id": "https://openbranddefinition.org/schemas/1.0.0/reasoning-chapter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chapterHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "content": {
      "minLength": 1,
      "type": "string"
    },
    "elementIds": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "const": "obds-reasoning-chapter"
    },
    "manifest": {
      "additionalProperties": false,
      "properties": {
        "contentHash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "contentHash"
      ],
      "type": "object"
    },
    "renderer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "title",
    "manifest",
    "elementIds",
    "content",
    "renderer",
    "chapterHash"
  ],
  "title": "OBDS Reasoning Chapter 1.0.0",
  "type": "object"
}

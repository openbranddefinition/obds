{
  "$id": "https://openbranddefinition.org/schemas/1.0.0/runtime-decision-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactHash": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    },
    "assemblyHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "checkResults": {
      "type": "array"
    },
    "decision": {
      "enum": [
        "released",
        "build_failed",
        "assembly_failed",
        "no_valid_artifact",
        "preflight_blocked",
        "postflight_blocked",
        "approval_required"
      ]
    },
    "kind": {
      "const": "obds-runtime-decision-record"
    },
    "modelCall": {
      "additionalProperties": false,
      "properties": {
        "called": {
          "type": "boolean"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "called",
        "provider",
        "model",
        "requestId"
      ],
      "type": "object"
    },
    "modelInputHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "recordId": {
      "type": "string"
    },
    "recordedAt": {
      "format": "date-time",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "targetId": {
      "type": [
        "string",
        "null"
      ]
    },
    "taskInputHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "recordId",
    "recordedAt",
    "targetId",
    "artifactHash",
    "taskInputHash",
    "decision",
    "modelCall",
    "checkResults",
    "assemblyHash",
    "modelInputHash"
  ],
  "title": "OBDS Runtime Decision Record 1.0.0",
  "type": "object"
}

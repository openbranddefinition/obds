{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbranddefinition.org/release-schemas/1.0.0/release-test-result.schema.json",
  "title": "OBDS release test result",
  "description": "Package-level release metadata. Not an OBDS Brand Truth contract and not part of the public OBDS schema surface.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "release",
    "status",
    "passed",
    "passedCount",
    "failedCount",
    "suiteCounts",
    "testOutputHash"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "obds-release-test-result" },
    "schemaVersion": { "$ref": "#/$defs/semver" },
    "release": { "$ref": "#/$defs/semver" },
    "status": { "enum": ["stable"] },
    "passed": { "type": "boolean" },
    "passedCount": { "type": "integer", "minimum": 0 },
    "failedCount": { "type": "integer", "minimum": 0, "maximum": 0 },
    "skippedCount": { "type": "integer", "minimum": 0, "maximum": 0 },
    "suiteCounts": { "$ref": "#/$defs/suiteCounts" },
    "testOutputHash": { "$ref": "#/$defs/sha256" },
    "promotedFrom": { "type": "string", "minLength": 1 },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "suiteCounts": {
      "type": "object",
      "description": "One non-negative integer per declared suite. Every suite in the official run must be present and no unknown suite may appear.",
      "required": [
        "foundation",
        "context-delivery",
        "context-assembly",
        "design-space",
        "integration",
        "golden",
        "adversarial"
      ],
      "additionalProperties": false,
      "properties": {
        "foundation": { "$ref": "#/$defs/suiteCount" },
        "context-delivery": { "$ref": "#/$defs/suiteCount" },
        "context-assembly": { "$ref": "#/$defs/suiteCount" },
        "design-space": { "$ref": "#/$defs/suiteCount" },
        "integration": { "$ref": "#/$defs/suiteCount" },
        "golden": { "$ref": "#/$defs/suiteCount" },
        "adversarial": { "$ref": "#/$defs/suiteCount" }
      }
    },
    "suiteCount": { "type": "integer", "minimum": 1, "maximum": 1000 }
  }
}

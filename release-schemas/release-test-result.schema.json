{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbranddefinition.org/release-schemas/1.0.0/release-test-result.schema.json",
  "title": "OBDS release test result",
  "description": "Package-level release metadata. Not an OBDS Brand Truth contract and not part of the public OBDS schema surface.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "release",
    "status",
    "passed",
    "passedCount",
    "failedCount",
    "suiteCounts",
    "testOutputHash",
    "implementation",
    "obdsVersion",
    "suiteHash",
    "suiteFileCount",
    "conformanceProfiles",
    "requiredCasesSkippedOrChanged",
    "skippedCount",
    "claimScope",
    "executedSuites"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "obds-release-test-result"
    },
    "schemaVersion": {
      "$ref": "#/$defs/semver"
    },
    "release": {
      "$ref": "#/$defs/semver"
    },
    "status": {
      "enum": [
        "stable"
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "passedCount": {
      "type": "integer",
      "minimum": 0
    },
    "failedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 0
    },
    "skippedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 0
    },
    "suiteCounts": {
      "$ref": "#/$defs/suiteCounts"
    },
    "testOutputHash": {
      "$ref": "#/$defs/sha256"
    },
    "promotedFrom": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation": {
      "description": "Section 26 requires a conformance result to identify the implementation by name and version.",
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "obdsVersion": {
      "description": "The exact OBDS version the claim is made for, per section 26.",
      "$ref": "#/$defs/semver"
    },
    "suiteHash": {
      "description": "Identity of the conformance suite that produced this result. Covers the suite runner, the seven suite directories and their fixtures; excludes the implementation under test.",
      "$ref": "#/$defs/sha256"
    },
    "suiteFileCount": {
      "type": "integer",
      "minimum": 1
    },
    "conformanceProfiles": {
      "description": "Profiles this release actually claims under section 26. A profile appears only when it is defensible: either a declared conformance suite names it and passed, or every requirement of its section is exercised by a named executed case.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "conformanceSection",
          "basis"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "conformanceSection": {
            "type": "string",
            "pattern": "^26\\.[0-9]+$"
          },
          "basis": {
            "type": "string",
            "minLength": 40
          },
          "declaredSuite": {
            "type": "string",
            "minLength": 1
          },
          "declaredCaseCount": {
            "type": "integer",
            "minimum": 1
          },
          "passedCount": {
            "type": "integer",
            "minimum": 0
          },
          "failedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 0
          },
          "suiteHash": {
            "$ref": "#/$defs/sha256"
          },
          "requirementsExercised": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "requirement",
                "cases"
              ],
              "additionalProperties": false,
              "properties": {
                "requirement": {
                  "type": "string",
                  "minLength": 1
                },
                "cases": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z-]+/[A-Za-z0-9_.]+::[A-Za-z0-9_]+(\\[.*\\])?$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "requiredCasesSkippedOrChanged": {
      "description": "Section 26 clause 4: no required case was skipped or changed.",
      "const": false
    },
    "claimScope": {
      "type": "string",
      "minLength": 1
    },
    "executedSuites": {
      "description": "Every suite the release executed, as coverage only. Carries no conformance claim.",
      "type": "object",
      "required": [
        "note",
        "counts"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 40
        },
        "counts": {
          "$ref": "#/$defs/suiteCounts"
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "suiteCounts": {
      "type": "object",
      "description": "One non-negative integer per declared suite. Every suite in the official run must be present and no unknown suite may appear.",
      "required": [
        "foundation",
        "context-delivery",
        "context-assembly",
        "design-space",
        "integration",
        "golden",
        "adversarial"
      ],
      "additionalProperties": false,
      "properties": {
        "foundation": {
          "$ref": "#/$defs/suiteCount"
        },
        "context-delivery": {
          "$ref": "#/$defs/suiteCount"
        },
        "context-assembly": {
          "$ref": "#/$defs/suiteCount"
        },
        "design-space": {
          "$ref": "#/$defs/suiteCount"
        },
        "integration": {
          "$ref": "#/$defs/suiteCount"
        },
        "golden": {
          "$ref": "#/$defs/suiteCount"
        },
        "adversarial": {
          "$ref": "#/$defs/suiteCount"
        }
      }
    },
    "suiteCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  }
}
